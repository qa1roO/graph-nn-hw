    <node id="ФЕРРИТНО-ПЕРЛИТНАЯ СТАЛЬ">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">Тип стали, из которой изготовлены листы толщиной 18,7 мм.</data>
      <data key="d2" />
