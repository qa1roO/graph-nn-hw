      <data key="d1">Сталь, содержащая ниобий и ванадий.</data>
      <data key="d2" />
    </node>
    <node id="МАЛЫХ СКОРОСТЯХ ОХЛАЖДЕНИЯ">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">Условие обработки листов после завершения ТМКП.</data>
