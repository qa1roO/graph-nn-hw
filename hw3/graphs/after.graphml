    <node id="СРЕДНЕУГЛЕРОДИСТЫЕ КОВАНЫЕ СТАЛИ">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">Стали, в которых ниобий тормозит рост аустенитного зерна.</data>
      <data key="d2" />
