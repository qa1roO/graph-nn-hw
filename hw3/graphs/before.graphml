      <data key="d1">Структура листов с неоднозначным поведением предела текучести.</data>
      <data key="d2" />
    </node>
    <node id="ФЕРРИТНО-БЕЙНИТНАЯ">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">Микроструктура стали 05Г2МФБ с мартенситно-аустенитными участками.</data>
