    </node>
    <node id="УПРУГО-ПЛАСТИЧЕСКОЕ ПОВЕДЕНИЕ">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">Характер поведения металла при испытаниях на растяжение.</data>
