      <data key="d0">СВОЙСТВО</data>
      <data key="d1">Оптимизация состава высокопрочных штампуемых сталей с метастабильным аустенитом.</data>
      <data key="d2" />
    </node>
    <node id="СПАЙ ТЕРМОПАРЫ">
      <data key="d0">СОЕДИНЕНИЕ</data>
      <data key="d1">Соединение из хромелевой и алюмелевой проволок, помещаемое в отверстия образца.</data>
      <data key="d2" />
