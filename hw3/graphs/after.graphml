      <data key="d2" />
    </node>
    <node id="ОКСПИД ЖЕЛЕЗА">
      <data key="d0">СОЕДИНЕНИЕ</data>
      <data key="d1">Продукт реакции железа с водой при конверторном процессе.</data>
      <data key="d2" />
    </node>
    <node id="ОПТИЧЕСКАЯ МИКРОСКОПИЯ">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">ОПТИЧЕСКАЯ МИКРОСКОПИЯ — это метод исследования микроструктуры с использованием оптических микроскопов. Также данный метод применяется для исследования структуры листов в целях выяснения механизма влияния отпуска.

