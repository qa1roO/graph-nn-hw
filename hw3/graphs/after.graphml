      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">Группа сталей, подвергаемая трубному переделу.</data>
      <data key="d2" />
    </node>
    <node id="СТАЛИ ФЕРРИТНО-ПЕРЛИТНОГО КЛАССА">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">Сталь для электросварных газопроводных труб большого диаметра.</data>
      <data key="d2" />
